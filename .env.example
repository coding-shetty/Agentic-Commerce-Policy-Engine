# ---------------------------------------------------------------------------
# Agentic Commerce Control Plane — environment configuration
# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Database ---
# SQLite works out of the box for local dev / demo. For Postgres use:
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./control_plane.db

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-this-is-not-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Demo-mode login lets you log in as "agent" / "admin" with the password below
# without a real user store. Disable in anything beyond a local demo.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_PASSWORD=demo-password

# --- Payments ---
# When true, no external calls are made — payments are simulated deterministically.
DEMO_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- AI Agent (LLM) ---
# Default provider is a local Ollama instance. LiteLLM is used as the
# abstraction layer so swapping to OpenAI/Anthropic/etc. later is a config change.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Set to true to force the deterministic scripted fallback instead of calling an LLM
# (useful in CI / environments with no local model available).
AGENT_FORCE_FALLBACK=false

# --- CORS ---
# Comma-separated list of allowed origins. Do NOT use "*" beyond local demos.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
